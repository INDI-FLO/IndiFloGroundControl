import QtQuick

import QGroundControl
import QGroundControl.Controls
import QGroundControl.Palette
import QGroundControl.ScreenTools


Item {
    id: root

    width: 300
    height: 330

    property bool collapsed: false

    property var _activeVehicle:
        QGroundControl.multiVehicleManager.activeVehicle

    property real rollAngle: {
        if (!_activeVehicle)
            return 0

        var r = _activeVehicle.roll.rawValue

        if (isNaN(r))
            return 0

        return r
    }

    property real pitchAngle: {
        if (!_activeVehicle)
            return 0

        var p = _activeVehicle.pitch.rawValue

        if (isNaN(p))
            return 0

        return p
    }


    // ============================================================
    // SLIDING CONTAINER
    // ============================================================

    Item {
        id: slidingPanel

        width: root.width
        height: root.height

        x: root.collapsed
           ? -(root.width - 42)
           : 0

        Behavior on x {
            NumberAnimation {
                duration: 350
                easing.type: Easing.InOutCubic
            }
        }


        // ========================================================
        // VERY SUBTLE GLASS BACKGROUND
        // ========================================================

        Rectangle {
            id: glassBackground

            anchors.fill: parent

            radius: 22

            color: "#140B151C"

            border.width: 1

            border.color: "#35FFFFFF"

            antialiasing: true
        }


        // ========================================================
        // GLASS INNER HIGHLIGHT
        // ========================================================

        Rectangle {
            anchors.fill: parent

            anchors.margins: 2

            radius: 20

            color: "#03000000"

            border.width: 1

            border.color: "#18FFFFFF"

            antialiasing: true
        }


        // ========================================================
        // TITLE
        // ========================================================

        Rectangle {
            id: titleBackground

            x: 13
            y: 8

            width: parent.width - 26
            height: 28

            radius: 9

            color: "#28131D25"

            border.width: 1

            border.color: "#25FFFFFF"
        }


        Text {
            anchors.centerIn: titleBackground

            text: "ARTIFICIAL HORIZON"

            color: "#F4F8FA"

            font.pixelSize: 10

            font.bold: true
        }


        Text {
            anchors.right: titleBackground.right

            anchors.rightMargin: 10

            anchors.verticalCenter:
                titleBackground.verticalCenter

            text: "AH"

            color: "#8ADFFF"

            font.pixelSize: 8

            font.bold: true
        }


        // ========================================================
        // CIRCULAR HORIZON
        // ========================================================

        Item {
            id: horizonArea

            x: 20

            y: 45

            width: 260

            height: 260

            clip: true


            // ====================================================
            // CIRCULAR MASK BACKGROUND
            // ====================================================

            Rectangle {
                id: horizonCircle

                anchors.fill: parent

                radius: width / 2

                color: "#09141D"

                border.width: 2

                border.color: "#70FFFFFF"

                antialiasing: true
            }


            // ====================================================
            // MOVING HORIZON CANVAS
            // ====================================================

            Canvas {
                id: horizonCanvas

                anchors.fill: parent

                antialiasing: true


                onPaint: {

                    var ctx = getContext("2d")

                    ctx.reset()

                    var w = width
                    var h = height

                    var cx = w / 2
                    var cy = h / 2

                    /*
                     * Pitch conversion.
                     *
                     * Approximately 5 pixels per degree.
                     */

                    var pitchPixels =
                        root.pitchAngle * 5.0


                    // =================================================
                    // OUTER CLIP CIRCLE
                    // =================================================

                    ctx.save()

                    ctx.beginPath()

                    ctx.arc(
                        cx,
                        cy,
                        Math.min(w, h) / 2 - 2,
                        0,
                        Math.PI * 2
                    )

                    ctx.clip()


                    // =================================================
                    // MOVE TO CENTER
                    // =================================================

                    ctx.translate(cx, cy)

                    ctx.rotate(
                        -root.rollAngle *
                        Math.PI / 180
                    )

                    ctx.translate(
                        0,
                        pitchPixels
                    )


                    // =================================================
                    // SKY
                    // =================================================

                    ctx.fillStyle = "#286487"

                    ctx.fillRect(
                        -w * 2,
                        -h * 2,
                        w * 4,
                        h * 2
                    )


                    // =================================================
                    // GROUND
                    // =================================================

                    ctx.fillStyle = "#594B3A"

                    ctx.fillRect(
                        -w * 2,
                        0,
                        w * 4,
                        h * 2
                    )


                    // =================================================
                    // HORIZON LINE
                    // =================================================

                    ctx.beginPath()

                    ctx.moveTo(
                        -w * 2,
                        0
                    )

                    ctx.lineTo(
                        w * 2,
                        0
                    )

                    ctx.lineWidth = 2

                    ctx.strokeStyle =
                        "#FFFFFF"

                    ctx.stroke()


                    // =================================================
                    // PITCH LADDER
                    // =================================================

                    for (
                        var pitch = -30;
                        pitch <= 30;
                        pitch += 5
                    ) {

                        if (pitch === 0)
                            continue


                        var py =
                            -pitch * 5


                        var major =
                            Math.abs(pitch) % 10 === 0


                        var lineLength =
                            major ? 76 : 42


                        ctx.beginPath()

                        ctx.moveTo(
                            -lineLength / 2,
                            py
                        )

                        ctx.lineTo(
                            lineLength / 2,
                            py
                        )

                        ctx.lineWidth =
                            major ? 2 : 1.5

                        ctx.strokeStyle =
                            "#F4F7FA"

                        ctx.stroke()


                        // =================================================
                        // PITCH NUMBERS
                        // =================================================

                        if (major) {

                            ctx.font =
                                "bold 10px sans-serif"

                            ctx.fillStyle =
                                "#FFFFFF"

                            ctx.textAlign =
                                "center"

                            ctx.textBaseline =
                                "middle"


                            ctx.fillText(
                                Math.abs(pitch).toString(),
                                -lineLength / 2 - 15,
                                py
                            )


                            ctx.fillText(
                                Math.abs(pitch).toString(),
                                lineLength / 2 + 15,
                                py
                            )
                        }
                    }


                    ctx.restore()
                }
            }


            // ====================================================
            // OUTER CIRCLE GLASS
            // ====================================================

            Rectangle {
                anchors.fill: parent

                radius: width / 2

                color: "#04FFFFFF"

                border.width: 1

                border.color: "#45FFFFFF"

                antialiasing: true
            }


            // ====================================================
            // ROLL SCALE
            // ====================================================

            Canvas {
                id: rollScale

                anchors.fill: parent

                antialiasing: true


                onPaint: {

                    var ctx = getContext("2d")

                    ctx.reset()


                    var cx =
                        width / 2

                    var cy =
                        height / 2


                    var radius =
                        width / 2 - 10


                    // =================================================
                    // ROLL TICKS
                    // =================================================

                    for (
                        var angle = -60;
                        angle <= 60;
                        angle += 10
                    ) {

                        var radians =
                            angle *
                            Math.PI /
                            180


                        var outerX =
                            cx +
                            Math.sin(radians) *
                            radius


                        var outerY =
                            cy -
                            Math.cos(radians) *
                            radius


                        var tickLength =
                            angle % 30 === 0
                                ? 14
                                : 8


                        var innerRadius =
                            radius -
                            tickLength


                        var innerX =
                            cx +
                            Math.sin(radians) *
                            innerRadius


                        var innerY =
                            cy -
                            Math.cos(radians) *
                            innerRadius


                        ctx.beginPath()

                        ctx.moveTo(
                            innerX,
                            innerY
                        )

                        ctx.lineTo(
                            outerX,
                            outerY
                        )

                        ctx.lineWidth =
                            angle % 30 === 0
                                ? 2
                                : 1.5

                        ctx.strokeStyle =
                            "#F2F7FA"

                        ctx.stroke()
                    }


                    // =================================================
                    // ROLL TRIANGLE
                    // =================================================

                    ctx.beginPath()

                    ctx.moveTo(
                        cx,
                        8
                    )

                    ctx.lineTo(
                        cx - 9,
                        25
                    )

                    ctx.lineTo(
                        cx + 9,
                        25
                    )

                    ctx.closePath()

                    ctx.fillStyle =
                        "#FFD447"

                    ctx.fill()


                    ctx.lineWidth = 1

                    ctx.strokeStyle =
                        "#FFFFFF"

                    ctx.stroke()
                }
            }


            // ====================================================
            // AIRCRAFT REFERENCE SYMBOL
            // ====================================================

            Item {
                id: aircraft

                anchors.centerIn:
                    parent

                width: 130

                height: 60


                // LEFT WING

                Rectangle {
                    x: 4

                    y: 28

                    width: 45

                    height: 4

                    radius: 2

                    color: "#FFD447"
                }


                // RIGHT WING

                Rectangle {
                    x: 81

                    y: 28

                    width: 45

                    height: 4

                    radius: 2

                    color: "#FFD447"
                }


                // CENTER

                Rectangle {
                    anchors.centerIn:
                        parent

                    width: 12

                    height: 12

                    radius: 6

                    color: "#FFD447"

                    border.width: 1

                    border.color: "#FFFFFF"
                }


                // NOSE

                Rectangle {
                    anchors.horizontalCenter:
                        parent.horizontalCenter

                    y: 30

                    width: 4

                    height: 17

                    radius: 2

                    color: "#FFD447"
                }
            }


            // ====================================================
            // CENTRAL HORIZONTAL REFERENCE
            // ====================================================

            Rectangle {
                anchors.centerIn:
                    parent

                width: 135

                height: 1

                color: "#55FFFFFF"
            }


            // ====================================================
            // CIRCULAR INNER RING
            // ====================================================

            Rectangle {
                anchors.fill: parent

                anchors.margins: 18

                radius:
                    width / 2

                color: "transparent"

                border.width: 1

                border.color: "#25FFFFFF"
            }
        }


        // ========================================================
        // DATA PANEL
        // ========================================================

        Rectangle {
            id: dataPanel

            x: 55

            y: 309

            width: 190

            height: 25

            radius: 8

            color: "#24131D25"

            border.width: 1

            border.color: "#25FFFFFF"


            Row {
                anchors.centerIn:
                    parent

                spacing: 20


                Text {
                    text:
                        "R " +
                        root.rollAngle.toFixed(1) +
                        "°"

                    color: "#FFFFFF"

                    font.pixelSize: 9

                    font.bold: true
                }


                Text {
                    text:
                        "P " +
                        root.pitchAngle.toFixed(1) +
                        "°"

                    color: "#FFFFFF"

                    font.pixelSize: 9

                    font.bold: true
                }
            }
        }


        // ========================================================
        // COLLAPSE HANDLE
        // ========================================================

        Rectangle {
            id: collapseHandle

            anchors.right:
                parent.right

            anchors.verticalCenter:
                horizonArea.verticalCenter

            width: 36

            height: 72

            radius: 12

            color: "#30141D25"

            border.width: 1

            border.color: "#45FFFFFF"


            Text {
                anchors.centerIn:
                    parent

                text:
                    root.collapsed
                        ? "›"
                        : "‹"

                color: "#FFFFFF"

                font.pixelSize: 25

                font.bold: true
            }


            MouseArea {
                anchors.fill:
                    parent

                cursorShape:
                    Qt.PointingHandCursor

                onClicked: {

                    root.collapsed =
                        !root.collapsed
                }
            }
        }
    }
}
