/****************************************************************************
 *
 * IndiFlo Ground Control
 *
 * Professional Transparent Glass Flight Instrument
 *
 * Artificial Horizon
 * Yaw / Heading Compass
 * Roll / Pitch / Yaw readout
 *
 ****************************************************************************/

import QtQuick
import QGroundControl


Item {
    id: root

    /*
     * ================================================================
     * MAIN SIZE
     *
     * Designed around approximately 65% of the larger HUD concept.
     * ================================================================
     */

    width: 300
    height: 485

    property bool collapsed: false

    property var _activeVehicle:
        QGroundControl.multiVehicleManager.activeVehicle


    /*
     * ================================================================
     * LIVE ROLL
     * ================================================================
     */

    property real rollAngle: {
        if (!_activeVehicle)
            return 0

        var value = _activeVehicle.roll.rawValue

        if (isNaN(value))
            return 0

        return value
    }


    /*
     * ================================================================
     * LIVE PITCH
     * ================================================================
     */

    property real pitchAngle: {
        if (!_activeVehicle)
            return 0

        var value = _activeVehicle.pitch.rawValue

        if (isNaN(value))
            return 0

        return value
    }


    /*
     * ================================================================
     * LIVE YAW / HEADING
     * ================================================================
     */

    property real yawAngle: {
        if (!_activeVehicle)
            return 0

        var value = _activeVehicle.yaw.rawValue

        if (isNaN(value))
            return 0

        return value
    }


    /*
     * ================================================================
     * COLLAPSIBLE SLIDING PANEL
     * ================================================================
     */

    Item {
        id: instrumentPanel

        width: 270
        height: root.height

        x: root.collapsed
           ? -(width - 30)
           : 0

        Behavior on x {
            NumberAnimation {
                duration: 320
                easing.type: Easing.InOutCubic
            }
        }


        /*
         * ============================================================
         * GLASS OUTER PANEL
         * ============================================================
         */

        Rectangle {
            id: glassPanel

            anchors.fill: parent

            radius: 20

            color: "#10000000"

            border.width: 1

            border.color: "#65FFFFFF"

            antialiasing: true
        }


        /*
         * ============================================================
         * INNER GLASS BORDER
         * ============================================================
         */

        Rectangle {
            anchors.fill: parent

            anchors.margins: 4

            radius: 17

            color: "transparent"

            border.width: 1

            border.color: "#20FFFFFF"

            antialiasing: true
        }


        /*
         * ============================================================
         * TITLE
         * ============================================================
         */

        Rectangle {
            id: titleArea

            x: 12
            y: 10

            width: parent.width - 24
            height: 42

            radius: 10

            color: "#12000000"

            border.width: 1

            border.color: "#30FFFFFF"
        }


        Text {
            anchors.centerIn: titleArea

            text: "ARTIFICIAL HORIZON"

            color: "#F5F8FA"

            font.pixelSize: 15

            font.bold: true
        }


        Text {
            anchors.right: titleArea.right

            anchors.rightMargin: 12

            anchors.verticalCenter: titleArea.verticalCenter

            text: "AH"

            color: "#69D8FF"

            font.pixelSize: 12

            font.bold: true
        }


        /*
         * ============================================================
         * ARTIFICIAL HORIZON
         * ============================================================
         */

        Item {
            id: horizon

            x: 28
            y: 62

            width: 214
            height: 214


            /*
             * ========================================================
             * HORIZON CANVAS
             * ========================================================
             */

            Canvas {
                id: horizonCanvas

                anchors.fill: parent

                antialiasing: true

                onPaint: {

                    var ctx = getContext("2d")

                    ctx.reset()

                    var cx = width / 2
                    var cy = height / 2
                    var radius = width / 2 - 4

                    /*
                     * ------------------------------------------------
                     * Circular clipping
                     * ------------------------------------------------
                     */

                    ctx.save()

                    ctx.beginPath()
                    ctx.arc(cx, cy, radius, 0, Math.PI * 2)
                    ctx.clip()


                    /*
                     * ------------------------------------------------
                     * Aircraft attitude transformation
                     * ------------------------------------------------
                     */

                    ctx.translate(cx, cy)

                    ctx.rotate(
                        rollAngle * Math.PI / 180
                    )

                    /*
                     * Pitch scale.
                     *
                     * 1 degree = approximately 3 pixels.
                     */

                    var pitchOffset =
                        pitchAngle * 3.0


                    /*
                     * ------------------------------------------------
                     * SKY
                     * ------------------------------------------------
                     */

                    ctx.fillStyle = "#14558A"

                    ctx.fillRect(
                        -radius * 2,
                        -radius * 2 + pitchOffset,
                        radius * 4,
                        radius * 2
                    )


                    /*
                     * ------------------------------------------------
                     * GROUND
                     * ------------------------------------------------
                     */

                    ctx.fillStyle = "#3A3025"

                    ctx.fillRect(
                        -radius * 2,
                        pitchOffset,
                        radius * 4,
                        radius * 2
                    )


                    /*
                     * ------------------------------------------------
                     * HORIZON LINE
                     * ------------------------------------------------
                     */

                    ctx.beginPath()

                    ctx.moveTo(
                        -radius * 2,
                        pitchOffset
                    )

                    ctx.lineTo(
                        radius * 2,
                        pitchOffset
                    )

                    ctx.lineWidth = 1.5

                    ctx.strokeStyle = "#FFFFFF"

                    ctx.stroke()


                    /*
                     * ------------------------------------------------
                     * PITCH LINES
                     * ------------------------------------------------
                     */

                    var pitchValues = [
                        -20,
                        -10,
                        10,
                        20
                    ]

                    for (var i = 0;
                         i < pitchValues.length;
                         i++) {

                        var p = pitchValues[i]

                        var py =
                            pitchOffset - p * 3

                        var lineLength =
                            Math.abs(p) === 10
                            ? 32
                            : 44

                        ctx.beginPath()

                        ctx.moveTo(
                            -lineLength,
                            py
                        )

                        ctx.lineTo(
                            lineLength,
                            py
                        )

                        ctx.lineWidth =
                            Math.abs(p) === 10
                            ? 1.4
                            : 1.2

                        ctx.strokeStyle =
                            "#E7EEF2"

                        ctx.stroke()


                        /*
                         * Left number
                         */

                        ctx.font = "11px sans-serif"

                        ctx.fillStyle = "#F0F3F5"

                        ctx.textAlign = "right"

                        ctx.textBaseline = "middle"

                        ctx.fillText(
                            Math.abs(p),
                            -lineLength - 10,
                            py
                        )


                        /*
                         * Right number
                         */

                        ctx.textAlign = "left"

                        ctx.fillText(
                            Math.abs(p),
                            lineLength + 10,
                            py
                        )
                    }


                    ctx.restore()


                    /*
                     * =================================================
                     * OUTER CIRCLE
                     * =================================================
                     */

                    ctx.beginPath()

                    ctx.arc(
                        cx,
                        cy,
                        radius,
                        0,
                        Math.PI * 2
                    )

                    ctx.lineWidth = 1.3

                    ctx.strokeStyle = "#DDE7EC"

                    ctx.stroke()


                    /*
                     * =================================================
                     * INNER CIRCLE
                     * =================================================
                     */

                    ctx.beginPath()

                    ctx.arc(
                        cx,
                        cy,
                        radius - 12,
                        0,
                        Math.PI * 2
                    )

                    ctx.lineWidth = 1

                    ctx.strokeStyle = "#45FFFFFF"

                    ctx.stroke()


                    /*
                     * =================================================
                     * ATTITUDE TICK MARKS
                     * =================================================
                     */

                    for (var a = -60;
                         a <= 60;
                         a += 5) {

                        var angle =
                            (a - 90) *
                            Math.PI / 180

                        var outerR =
                            radius - 1

                        var innerR =
                            (a % 10 === 0)
                            ? radius - 11
                            : radius - 7

                        var x1 =
                            cx +
                            Math.cos(angle) *
                            outerR

                        var y1 =
                            cy +
                            Math.sin(angle) *
                            outerR

                        var x2 =
                            cx +
                            Math.cos(angle) *
                            innerR

                        var y2 =
                            cy +
                            Math.sin(angle) *
                            innerR

                        ctx.beginPath()

                        ctx.moveTo(x1, y1)

                        ctx.lineTo(x2, y2)

                        ctx.lineWidth =
                            (a % 10 === 0)
                            ? 1.5
                            : 0.8

                        ctx.strokeStyle =
                            "#E9EFF2"

                        ctx.stroke()
                    }


                    /*
                     * =================================================
                     * CARDINAL / INTERCARDINAL DIRECTIONS
                     * =================================================
                     */

                    var directions = [
                        {
                            text: "N",
                            angle: 0
                        },
                        {
                            text: "NE",
                            angle: 45
                        },
                        {
                            text: "E",
                            angle: 90
                        },
                        {
                            text: "SE",
                            angle: 135
                        },
                        {
                            text: "S",
                            angle: 180
                        },
                        {
                            text: "SW",
                            angle: 225
                        },
                        {
                            text: "W",
                            angle: 270
                        },
                        {
                            text: "NW",
                            angle: 315
                        }
                    ]

                    for (var d = 0;
                         d < directions.length;
                         d++) {

                        var dir =
                            directions[d]

                        var da =
                            (dir.angle - 90) *
                            Math.PI / 180

                        var dr =
                            radius + 12

                        var dx =
                            cx +
                            Math.cos(da) *
                            dr

                        var dy =
                            cy +
                            Math.sin(da) *
                            dr

                        ctx.font =
                            dir.text.length === 1
                            ? "bold 18px sans-serif"
                            : "bold 12px sans-serif"

                        ctx.fillStyle =
                            "#F5F7F8"

                        ctx.textAlign = "center"

                        ctx.textBaseline = "middle"

                        ctx.fillText(
                            dir.text,
                            dx,
                            dy
                        )
                    }


                    /*
                     * =================================================
                     * YELLOW CARDINAL MARKERS
                     * =================================================
                     */

                    var markerAngles = [
                        0,
                        45,
                        90,
                        135,
                        180,
                        225,
                        270,
                        315
                    ]

                    for (var m = 0;
                         m < markerAngles.length;
                         m++) {

                        var ma =
                            (markerAngles[m] - 90) *
                            Math.PI / 180

                        var mr1 =
                            radius + 1

                        var mr2 =
                            radius + 8

                        var mx1 =
                            cx +
                            Math.cos(ma) *
                            mr1

                        var my1 =
                            cy +
                            Math.sin(ma) *
                            mr1

                        var mx2 =
                            cx +
                            Math.cos(ma) *
                            mr2

                        var my2 =
                            cy +
                            Math.sin(ma) *
                            mr2

                        ctx.beginPath()

                        ctx.moveTo(mx1, my1)

                        ctx.lineTo(mx2, my2)

                        ctx.lineWidth = 3

                        ctx.strokeStyle =
                            "#FFC72C"

                        ctx.stroke()
                    }


                    /*
                     * =================================================
                     * AIRCRAFT ATTITUDE REFERENCE
                     * =================================================
                     */

                    ctx.save()

                    ctx.translate(cx, cy)

                    /*
                     * Left wing
                     */

                    ctx.beginPath()

                    ctx.moveTo(-52, 0)

                    ctx.lineTo(-18, 0)

                    ctx.lineWidth = 5

                    ctx.strokeStyle = "#FFC72C"

                    ctx.lineCap = "round"

                    ctx.stroke()


                    /*
                     * Right wing
                     */

                    ctx.beginPath()

                    ctx.moveTo(18, 0)

                    ctx.lineTo(52, 0)

                    ctx.lineWidth = 5

                    ctx.strokeStyle = "#FFC72C"

                    ctx.stroke()


                    /*
                     * Center
                     */

                    ctx.beginPath()

                    ctx.arc(
                        0,
                        0,
                        6,
                        0,
                        Math.PI * 2
                    )

                    ctx.fillStyle = "#FFC72C"

                    ctx.fill()

                    ctx.lineWidth = 1

                    ctx.strokeStyle = "#FFFFFF"

                    ctx.stroke()


                    /*
                     * Center vertical marker
                     */

                    ctx.beginPath()

                    ctx.moveTo(0, 6)

                    ctx.lineTo(0, 17)

                    ctx.lineWidth = 3

                    ctx.strokeStyle = "#FFC72C"

                    ctx.stroke()

                    ctx.restore()
                }


                Connections {
                    target: root

                    function onRollAngleChanged() {
                        horizonCanvas.requestPaint()
                    }

                    function onPitchAngleChanged() {
                        horizonCanvas.requestPaint()
                    }
                }
            }
        }


        /*
         * ============================================================
         * COLLAPSE HANDLE
         * ============================================================
         */

        Rectangle {
            id: collapseHandle

            x: parent.width - 1

            y: 190

            width: 31

            height: 62

            radius: 15

            color: "#10000000"

            border.width: 1

            border.color: "#55FFFFFF"


            Text {
                anchors.centerIn: parent

                text: root.collapsed
                      ? "‹"
                      : "›"

                color: "#FFFFFF"

                font.pixelSize: 30

                font.bold: true
            }


            MouseArea {
                anchors.fill: parent

                cursorShape: Qt.PointingHandCursor

                onClicked: {
                    root.collapsed =
                        !root.collapsed
                }
            }
        }


        /*
         * ============================================================
         * YAW / HDG TITLE
         * ============================================================
         */

        Text {
            id: yawTitle

            x: 0

            y: 284

            width: parent.width

            text: "YAW / HDG"

            horizontalAlignment:
                Text.AlignHCenter

            color: "#69D8FF"

            font.pixelSize: 12

            font.bold: true
        }


        /*
         * ============================================================
         * YAW COMPASS
         * ============================================================
         */

        Item {
            id: yawCompass

            x: 25

            y: 305

            width: 220

            height: 220


            Canvas {
                id: compassCanvas

                anchors.fill: parent

                antialiasing: true

                onPaint: {

                    var ctx = getContext("2d")

                    ctx.reset()

                    var cx = width / 2
                    var cy = height / 2

                    var radius =
                        width / 2 - 7


                    /*
                     * =================================================
                     * DARK GLASS CIRCLE
                     * =================================================
                     */

                    ctx.beginPath()

                    ctx.arc(
                        cx,
                        cy,
                        radius,
                        0,
                        Math.PI * 2
                    )

                    ctx.fillStyle =
                        "#12000000"

                    ctx.fill()

                    ctx.lineWidth = 1.2

                    ctx.strokeStyle =
                        "#BFFFFFFF"

                    ctx.stroke()


                    /*
                     * =================================================
                     * INNER COMPASS RINGS
                     * =================================================
                     */

                    var rings = [
                        radius - 28,
                        radius - 60
                    ]

                    for (var r = 0;
                         r < rings.length;
                         r++) {

                        ctx.beginPath()

                        ctx.arc(
                            cx,
                            cy,
                            rings[r],
                            0,
                            Math.PI * 2
                        )

                        ctx.lineWidth = 1

                        ctx.strokeStyle =
                            "#30FFFFFF"

                        ctx.stroke()
                    }


                    /*
                     * =================================================
                     * ROTATING HEADING SCALE
                     * =================================================
                     */

                    ctx.save()

                    ctx.translate(cx, cy)

                    /*
                     * Yaw rotates the compass scale.
                     */

                    ctx.rotate(
                        -yawAngle *
                        Math.PI / 180
                    )


                    /*
                     * Tick marks
                     */

                    for (var i = 0;
                         i < 72;
                         i++) {

                        var deg =
                            i * 5

                        var angle =
                            (deg - 90) *
                            Math.PI / 180

                        var outer =
                            radius - 1

                        var inner =
                            (deg % 30 === 0)
                            ? radius - 13
                            : radius - 8

                        var x1 =
                            Math.cos(angle) *
                            outer

                        var y1 =
                            Math.sin(angle) *
                            outer

                        var x2 =
                            Math.cos(angle) *
                            inner

                        var y2 =
                            Math.sin(angle) *
                            inner

                        ctx.beginPath()

                        ctx.moveTo(x1, y1)

                        ctx.lineTo(x2, y2)

                        ctx.lineWidth =
                            deg % 30 === 0
                            ? 1.6
                            : 0.8

                        ctx.strokeStyle =
                            "#DDE6EA"

                        ctx.stroke()
                    }


                    /*
                     * =================================================
                     * DEGREE LABELS
                     * =================================================
                     */

                    var degreeLabels = [
                        { text: "330", angle: 330 },
                        { text: "030", angle: 30 },
                        { text: "060", angle: 60 },
                        { text: "120", angle: 120 },
                        { text: "150", angle: 150 },
                        { text: "210", angle: 210 },
                        { text: "240", angle: 240 },
                        { text: "300", angle: 300 }
                    ]

                    var labelRadius =
                        radius - 35

                    for (var q = 0;
                         q < degreeLabels.length;
                         q++) {

                        var item =
                            degreeLabels[q]

                        var la =
                            (item.angle - 90) *
                            Math.PI / 180

                        var lx =
                            Math.cos(la) *
                            labelRadius

                        var ly =
                            Math.sin(la) *
                            labelRadius

                        ctx.font =
                            "10px sans-serif"

                        ctx.fillStyle =
                            "#E7EDF0"

                        ctx.textAlign =
                            "center"

                        ctx.textBaseline =
                            "middle"

                        ctx.fillText(
                            item.text,
                            lx,
                            ly
                        )
                    }


                    /*
                     * =================================================
                     * CARDINAL LETTERS
                     * =================================================
                     */

                    var cardinal = [
                        { text: "N", angle: 0 },
                        { text: "E", angle: 90 },
                        { text: "S", angle: 180 },
                        { text: "W", angle: 270 }
                    ]

                    var cardinalRadius =
                        radius - 13

                    for (var c = 0;
                         c < cardinal.length;
                         c++) {

                        var card =
                            cardinal[c]

                        var ca =
                            (card.angle - 90) *
                            Math.PI / 180

                        var cxx =
                            Math.cos(ca) *
                            cardinalRadius

                        var cyy =
                            Math.sin(ca) *
                            cardinalRadius

                        ctx.font =
                            "bold 15px sans-serif"

                        /*
                         * North is highlighted.
                         */

                        ctx.fillStyle =
                            card.text === "N"
                            ? "#FF4A3D"
                            : "#F4F6F7"

                        ctx.textAlign =
                            "center"

                        ctx.textBaseline =
                            "middle"

                        ctx.fillText(
                            card.text,
                            cxx,
                            cyy
                        )
                    }


                    ctx.restore()


                    /*
                     * =================================================
                     * FIXED AIRCRAFT SYMBOL
                     * =================================================
                     */

                    ctx.save()

                    ctx.translate(
                        cx,
                        cy
                    )


                    /*
                     * Small professional aircraft
                     */

                    ctx.beginPath()

                    ctx.moveTo(0, -35)

                    ctx.lineTo(7, -12)

                    ctx.lineTo(31, 2)

                    ctx.lineTo(31, 10)

                    ctx.lineTo(7, 5)

                    ctx.lineTo(7, 35)

                    ctx.lineTo(15, 43)

                    ctx.lineTo(15, 48)

                    ctx.lineTo(0, 44)

                    ctx.lineTo(-15, 48)

                    ctx.lineTo(-15, 43)

                    ctx.lineTo(-7, 35)

                    ctx.lineTo(-7, 5)

                    ctx.lineTo(-31, 10)

                    ctx.lineTo(-31, 2)

                    ctx.lineTo(-7, -12)

                    ctx.closePath()

                    ctx.lineWidth = 1.8

                    ctx.strokeStyle =
                        "#FFFFFF"

                    ctx.fillStyle =
                        "#05090C"

                    ctx.fill()

                    ctx.stroke()


                    /*
                     * Yellow nose reference
                     */

                    ctx.beginPath()

                    ctx.moveTo(0, -48)

                    ctx.lineTo(-7, -37)

                    ctx.lineTo(7, -37)

                    ctx.closePath()

                    ctx.fillStyle =
                        "#FFC72C"

                    ctx.fill()

                    ctx.lineWidth = 1

                    ctx.strokeStyle =
                        "#FFFFFF"

                    ctx.stroke()


                    ctx.restore()


                    /*
                     * =================================================
                     * CENTER DOT
                     * =================================================
                     */

                    ctx.beginPath()

                    ctx.arc(
                        cx,
                        cy,
                        4,
                        0,
                        Math.PI * 2
                    )

                    ctx.fillStyle =
                        "#FFC72C"

                    ctx.fill()


                    /*
                     * =================================================
                     * HEADING VALUE
                     * =================================================
                     */

                    var heading =
                        ((yawAngle % 360) + 360) % 360

                    ctx.font =
                        "bold 22px sans-serif"

                    ctx.fillStyle =
                        "#FFC72C"

                    ctx.textAlign =
                        "center"

                    ctx.textBaseline =
                        "middle"

                    ctx.fillText(
                        Math.round(heading) + "°",
                        cx,
                        cy + 67
                    )
                }


                Connections {

                    target: root

                    function onYawAngleChanged() {
                        compassCanvas.requestPaint()
                    }
                }
            }
        }


        /*
         * ============================================================
         * ROLL / PITCH / YAW DATA
         * ============================================================
         */

        Rectangle {
            id: rpyPanel

            x: 18

            y: 455

            width: parent.width - 36

            height: 30

            radius: 10

            color: "#10000000"

            border.width: 1

            border.color: "#40FFFFFF"
        }


        Row {
            anchors.centerIn: rpyPanel

            spacing: 17


            Text {
                text:
                    "R  " +
                    Number(root.rollAngle).toFixed(1) +
                    "°"

                color: "#FFC72C"

                font.pixelSize: 11

                font.bold: true
            }


            Text {
                text:
                    "P  " +
                    Number(root.pitchAngle).toFixed(1) +
                    "°"

                color: "#69D8FF"

                font.pixelSize: 11

                font.bold: true
            }


            Text {
                text:
                    "Y  " +
                    Number(root.yawAngle).toFixed(1) +
                    "°"

                color: "#FFFFFF"

                font.pixelSize: 11

                font.bold: true
            }
        }
    }
}
