/****************************************************************************
 *
 * IndiFlo Ground Control
 *
 * Professional Glass Artificial Horizon
 *
 ****************************************************************************/

import QtQuick
import QtQuick.Controls

import QGroundControl
import QGroundControl.Controls
import QGroundControl.Palette
import QGroundControl.ScreenTools


Item {
    id: root

    width: 315
    height: 335

    /*
     * The component itself remains 315px wide.
     * The actual glass panel slides inside it.
     */

    property bool collapsed: false

    property var _activeVehicle:
        QGroundControl.multiVehicleManager.activeVehicle

    property real rollAngle:
        _activeVehicle &&
        !isNaN(_activeVehicle.roll.rawValue)
            ? _activeVehicle.roll.rawValue
            : 0

    property real pitchAngle:
        _activeVehicle &&
        !isNaN(_activeVehicle.pitch.rawValue)
            ? _activeVehicle.pitch.rawValue
            : 0


    // =========================================================
    // MAIN SLIDING PANEL
    // =========================================================

    Item {
        id: slidingPanel

        width: root.width
        height: root.height

        /*
         * When collapsed, almost the complete instrument
         * slides outside the left side.
         *
         * A 42px handle remains visible.
         */

        x: root.collapsed
           ? -(root.width - 42)
           : 0

        Behavior on x {
            NumberAnimation {
                duration: 350
                easing.type: Easing.InOutCubic
            }
        }


        // =====================================================
        // OUTER GLASS
        // =====================================================

        Rectangle {
            id: glassPanel

            anchors.fill: parent

            radius: 20

            color: "#1609141D"

            border.width: 1

            border.color: "#55FFFFFF"

            antialiasing: true
        }


        // =====================================================
        // INNER GLASS HIGHLIGHT
        // =====================================================

        Rectangle {
            anchors.fill: parent

            anchors.margins: 2

            radius: 18

            color: "#080FFFFFF"

            border.width: 1

            border.color: "#20FFFFFF"
        }


        // =====================================================
        // TITLE
        // =====================================================

        Rectangle {
            id: titlePanel

            x: 12
            y: 8

            width: parent.width - 24
            height: 30

            radius: 9

            color: "#2415222D"

            border.width: 1

            border.color: "#35FFFFFF"


            Text {
                anchors.centerIn: parent

                text: "ARTIFICIAL HORIZON"

                color: "#F2F8FC"

                font.pixelSize: 10

                font.bold: true
            }


            Text {
                anchors.right: parent.right

                anchors.rightMargin: 10

                anchors.verticalCenter: parent.verticalCenter

                text: "AH"

                color: "#75D9FF"

                font.pixelSize: 9

                font.bold: true
            }
        }


        // =====================================================
        // HORIZON WINDOW
        // =====================================================

        Item {
            id: horizonWindow

            x: 14
            y: 45

            width: parent.width - 28
            height: 250

            clip: true


            // =================================================
            // DARK BACKGROUND
            // =================================================

            Rectangle {
                anchors.fill: parent

                radius: 15

                color: "#081018"
            }


            // =================================================
            // MOVING HORIZON
            // =================================================

            Item {
                id: horizon

                width: horizonWindow.width * 4

                height: horizonWindow.height * 8

                anchors.centerIn: horizonWindow


                property real pitchOffset:
                    pitchAngle *
                    horizonWindow.height /
                    45.0


                // =================================================
                // SKY
                // =================================================

                Rectangle {
                    anchors.fill: parent

                    color: "#20577D"
                }


                // =================================================
                // GROUND
                // =================================================

                Rectangle {
                    anchors.left: parent.left

                    anchors.right: parent.right

                    anchors.bottom: parent.bottom

                    height: parent.height / 2

                    color: "#514637"
                }


                // =================================================
                // HORIZON LINE
                // =================================================

                Rectangle {
                    anchors.horizontalCenter:
                        parent.horizontalCenter

                    y:
                        parent.height / 2 - 1

                    width:
                        parent.width

                    height:
                        2

                    color:
                        "#F4F7FA"
                }


                // =================================================
                // PITCH LADDER
                // =================================================

                Item {
                    id: pitchLadder

                    anchors.fill: parent


                    Repeater {
                        model: 9


                        Item {
                            property int pitchValue:
                                (index - 4) * 10

                            property real pitchY:
                                parent.height / 2 -
                                pitchValue *
                                horizonWindow.height /
                                45.0


                            x:
                                parent.width / 2 - 55

                            y:
                                pitchY - 1


                            visible:
                                pitchValue !== 0


                            Rectangle {
                                anchors.horizontalCenter:
                                    parent.horizontalCenter

                                width:
                                    pitchValue % 20 === 0
                                        ? 80
                                        : 48

                                height:
                                    2

                                color:
                                    "#E8FFFFFF"

                                radius:
                                    1
                            }


                            Text {
                                anchors.right:
                                    parent.left

                                anchors.rightMargin:
                                    8

                                anchors.verticalCenter:
                                    parent.verticalCenter

                                text:
                                    Math.abs(pitchValue)

                                color:
                                    "#E8FFFFFF"

                                font.pixelSize:
                                    9

                                font.bold:
                                    true
                            }


                            Text {
                                anchors.left:
                                    parent.right

                                anchors.leftMargin:
                                    8

                                anchors.verticalCenter:
                                    parent.verticalCenter

                                text:
                                    Math.abs(pitchValue)

                                color:
                                    "#E8FFFFFF"

                                font.pixelSize:
                                    9

                                font.bold:
                                    true
                            }
                        }
                    }
                }


                // =================================================
                // HORIZON TRANSFORMATION
                // =================================================

                transform: [

                    Translate {
                        y: horizon.pitchOffset
                    },

                    Rotation {
                        origin.x:
                            horizon.width / 2

                        origin.y:
                            horizon.height / 2

                        angle:
                            -root.rollAngle
                    }
                ]
            }


            // =================================================
            // AIRCRAFT SYMBOL
            // =================================================

            Item {
                id: aircraftSymbol

                anchors.centerIn:
                    horizonWindow

                width: 140

                height: 60


                // LEFT WING

                Rectangle {
                    anchors.verticalCenter:
                        parent.verticalCenter

                    anchors.right:
                        parent.horizontalCenter

                    width: 45

                    height: 4

                    radius: 2

                    color: "#FFD34D"
                }


                // RIGHT WING

                Rectangle {
                    anchors.verticalCenter:
                        parent.verticalCenter

                    anchors.left:
                        parent.horizontalCenter

                    width: 45

                    height: 4

                    radius: 2

                    color: "#FFD34D"
                }


                // CENTER

                Rectangle {
                    anchors.centerIn:
                        parent

                    width: 18

                    height: 18

                    radius: 9

                    color: "#FFD34D"
                }


                // NOSE

                Rectangle {
                    anchors.horizontalCenter:
                        parent.horizontalCenter

                    anchors.top:
                        parent.verticalCenter

                    anchors.topMargin:
                        5

                    width: 4

                    height: 15

                    radius: 2

                    color: "#FFD34D"
                }
            }


            // =================================================
            // ROLL SCALE
            // =================================================

            Item {
                id: rollScale

                anchors.top:
                    horizonWindow.top

                anchors.horizontalCenter:
                    horizonWindow.horizontalCenter

                width:
                    horizonWindow.width

                height:
                    55


                Repeater {
                    model: 9


                    Rectangle {
                        property real rollValue:
                            (index - 4) * 15


                        width:
                            rollValue % 30 === 0
                                ? 3
                                : 2

                        height:
                            rollValue % 30 === 0
                                ? 16
                                : 9

                        color:
                            "#FFFFFF"


                        x:
                            parent.width / 2 +
                            Math.sin(
                                rollValue *
                                Math.PI / 180
                            ) * 92 -
                            width / 2


                        y:
                            7


                        rotation:
                            rollValue
                    }
                }


                // =================================================
                // ROLL POINTER
                // =================================================

                Canvas {
                    anchors.horizontalCenter:
                        parent.horizontalCenter

                    y:
                        1

                    width:
                        22

                    height:
                        22


                    onPaint: {

                        var ctx =
                            getContext("2d")

                        ctx.clearRect(
                            0,
                            0,
                            width,
                            height
                        )

                        ctx.beginPath()

                        ctx.moveTo(
                            width / 2,
                            height
                        )

                        ctx.lineTo(
                            2,
                            2
                        )

                        ctx.lineTo(
                            width - 2,
                            2
                        )

                        ctx.closePath()

                        ctx.fillStyle =
                            "#FFD34D"

                        ctx.fill()
                    }
                }
            }


            // =================================================
            // GLASS OVERLAY
            // =================================================

            Rectangle {
                anchors.fill:
                    parent

                radius:
                    15

                color:
                    "#05FFFFFF"

                border.width:
                    1

                border.color:
                    "#40FFFFFF"
            }


            // =================================================
            // CENTER REFERENCE
            // =================================================

            Rectangle {
                anchors.centerIn:
                    parent

                width:
                    7

                height:
                    7

                radius:
                    3.5

                color:
                    "#FFFFFF"

                opacity:
                    0.8
            }
        }


        // =====================================================
        // BOTTOM INFORMATION BAR
        // =====================================================

        Rectangle {
            id: informationBar

            anchors.bottom:
                parent.bottom

            anchors.bottomMargin:
                7

            anchors.horizontalCenter:
                parent.horizontalCenter

            width:
                175

            height:
                27

            radius:
                9

            color:
                "#2415222D"

            border.width:
                1

            border.color:
                "#30FFFFFF"


            Row {
                anchors.centerIn:
                    parent

                spacing:
                    20


                Text {
                    text:
                        "R " +
                        root.rollAngle.toFixed(1) +
                        "°"

                    color:
                        "#E8F7FF"

                    font.pixelSize:
                        10

                    font.bold:
                        true
                }


                Text {
                    text:
                        "P " +
                        root.pitchAngle.toFixed(1) +
                        "°"

                    color:
                        "#E8F7FF"

                    font.pixelSize:
                        10

                    font.bold:
                        true
                }
            }
        }


        // =====================================================
        // COLLAPSE / EXPAND HANDLE
        // =====================================================

        Rectangle {
            id: collapseHandle

            anchors.right:
                parent.right

            anchors.verticalCenter:
                parent.verticalCenter

            width:
                36

            height:
                76

            radius:
                12

            color:
                "#351A2834"

            border.width:
                1

            border.color:
                "#50FFFFFF"


            Text {
                anchors.centerIn:
                    parent

                text:
                    root.collapsed
                        ? "›"
                        : "‹"

                color:
                    "#EAF8FF"

                font.pixelSize:
                    26

                font.bold:
                    true
            }


            MouseArea {
                anchors.fill:
                    parent

                cursorShape:
                    Qt.PointingHandCursor

                onClicked: {
                    root.collapsed =
                        !root.collapsed
                }
            }
        }


        // =====================================================
        // WHOLE PANEL CLICK
        // =====================================================

        MouseArea {
            anchors.fill:
                parent

            anchors.rightMargin:
                40

            acceptedButtons:
                Qt.LeftButton

            onDoubleClicked: {
                root.collapsed =
                    !root.collapsed
            }
        }
    }
}
